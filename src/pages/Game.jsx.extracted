const CIRCUIT_DECORS = [
  'grandstand', 'led_barrier', 'floodlight', 'pit_building',
  'camera_tower', 'led_barrier', 'grandstand', 'start_gantry'
]

const NEON_DECORS = [
  'neon_building', 'billboard', 'neon_building', 'train',
  'neon_building', 'billboard', 'drone', 'bridge'
]

