function drawTraffic(ctx, t) {
  const { x, y, w, h, color, vType } = t
  const cx = x + w / 2, cy = y + h / 2, hw = w / 2, hh = h / 2

  ctx.save()
  ctx.translate(cx, cy)

  // 1. Soft Vehicle Shadow
  ctx.fillStyle = 'rgba(0,0,0,0.45)'
  ctx.beginPath()
  ctx.ellipse(2, 6, hw * 1.05, hh * 0.95, 0, 0, Math.PI * 2)
  ctx.fill()

  // 2. Headlight Beams (Forward Light Cones onto Asphalt)
  const beamG = ctx.createLinearGradient(0, -hh, 0, -hh - 90)
  beamG.addColorStop(0, vType.headlightColor || 'rgba(255,255,220,0.4)')
  beamG.addColorStop(1, 'transparent')
  ctx.fillStyle = beamG
  ctx.beginPath()
  ctx.moveTo(-hw * 0.75, -hh)
  ctx.lineTo(-hw * 1.25, -hh - 90)
  ctx.lineTo(hw * 1.25, -hh - 90)
  ctx.lineTo(hw * 0.75, -hh)
  ctx.closePath()
  ctx.fill()
