function getSectorInfo(dist) {
  const d = ((dist % CYCLE) + CYCLE) % CYCLE
  const idx = d < SECTOR_LEN ? 0 : 1
  const sec = idx === 0 ? SEC_CIRCUIT : SEC_NEON
  const nextSec = idx === 0 ? SEC_NEON : SEC_CIRCUIT
  let inTransition = false, transProgress = 0
  if (d >= TRANS1_START && d < SECTOR_LEN) {
    inTransition = true
    transProgress = (d - TRANS1_START) / TRANSITION_LEN
  } else if (d >= TRANS2_START) {
    inTransition = true
    transProgress = (d - TRANS2_START) / TRANSITION_LEN
  }
  let blend = 0
  if (inTransition) blend = Math.max(0, Math.min(1, transProgress))
  return { idx, sec, nextSec, inTransition, transProgress, blend }
}

