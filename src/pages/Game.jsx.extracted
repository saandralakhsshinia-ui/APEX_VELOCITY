class Spark{
  constructor(x,y){this.x=x;this.y=y;this.vx=(Math.random()-0.5)*10;this.vy=(Math.random()-0.5)*10;this.life=1;this.decay=0.02+Math.random()*0.03;this.size=1.5+Math.random()*3;this.color=Math.random()>0.5?'#ff4444':'#ffaa00'}
  update(){this.x+=this.vx;this.y+=this.vy;this.vy+=0.15;this.life-=this.decay}
  draw(ctx){if(this.life<=0)return;ctx.globalAlpha=Math.max(0,this.life);ctx.fillStyle=this.color;ctx.beginPath();ctx.arc(this.x,this.y,this.size,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1}
}
      ctx.fill()
      ctx.shadowBlur = 0
      break
    }

    case 'pit_building': {
      // F1 Garage & Telemetry Building
      ctx.fillStyle = 'rgba(38, 40, 48, 0.92)'
      ctx.fillRect(3, -42, 68, 42)
      ctx.fillStyle = sec.edge
      ctx.fillRect(3, -44, 68, 2.5)

      // Garages & Telemetry Screens
      for (let g = 0; g < 3; g++) {
        ctx.fillStyle = '#181820'
        ctx.fillRect(8 + g * 20, -22, 14, 22)
        ctx.fillStyle = 'rgba(0, 200, 255, 0.25)'
        ctx.fillRect(10 + g * 20, -36, 10, 8)
      }

      // Live LED Ticker Display
      ctx.fillStyle = 'rgba(10, 10, 15, 0.9)'
      ctx.fillRect(3, -8, 68, 8)
      ctx.fillStyle = sec.edge
      ctx.font = 'bold 5px Orbitron, sans-serif'
      ctx.textAlign = 'left'
      const scrollPos = (t * 24 + sSeed * 10) % 120
      ctx.fillText('APEX VELOCITY ★ PIT LANE LIVE', 5 - scrollPos, -2)
      ctx.fillText('APEX VELOCITY ★ PIT LANE LIVE', 5 - scrollPos + 120, -2)
      break
    }

    case 'led_barrier': {
      // FIA Heavy Barrier with Sponsor Board
      ctx.fillStyle = '#282832'
      ctx.fillRect(2, -22, 54, 22)
      ctx.fillStyle = '#404050'
      ctx.fillRect(2, -22, 54, 3)

      ctx.strokeStyle = sec.edge
      ctx.lineWidth = 1.5
      ctx.strokeRect(4, -19, 50, 16)

      const sponsors = ['APEX', 'VELOCITY', 'ZENITH', 'FORMULA']
      const spName = sponsors[Math.floor(seed(sSeed) * sponsors.length)]
      ctx.fillStyle = sec.edge
      ctx.font = 'bold 7px Orbitron, sans-serif'
      ctx.textAlign = 'center'
      ctx.fillText(spName, 29, -8)
      break
    }

    case 'start_gantry': {
      // Start / Finish Line Arch Gantry
      ctx.fillStyle = '#3a3a48'
      ctx.fillRect(0, -90, 8, 90)
      ctx.fillRect(52, -90, 8, 90)
      ctx.fillStyle = 'rgba(25, 25, 35, 0.95)'
      ctx.fillRect(-5, -94, 70, 12)
      ctx.strokeStyle = sec.edge
      ctx.lineWidth = 1.5
      ctx.strokeRect(-5, -94, 70, 12)

      // Digital timer readout
      ctx.fillStyle = '#00ff44'
      ctx.font = 'bold 6px Orbitron, sans-serif'
      ctx.textAlign = 'center'
      ctx.fillText('00:42.185', 30, -86)
      break
    }

    case 'neon_building': {
      // High-rise Cyber Skyscraper
      const bh = 65 + seed(sSeed) * 110
      ctx.fillStyle = 'rgba(16, 16, 34, 0.95)'
      ctx.fillRect(3, -bh, 54, bh)

      // Structural Neon Trim
      ctx.strokeStyle = sec.edge
