/* ═══════════════════════════════════════════════════════════════
   DRAW — STABLE ENVIRONMENT DECORATIONS & PARALLAX STRUCTURES
   ═══════════════════════════════════════════════════════════════ */
function drawDecor(ctx, type, x, y, side, sec, t, blend, worldSeed, depthFactor = 1.0) {
  const f = side === 'right' ? -1 : 1
  ctx.save()
  ctx.translate(x, y)
  ctx.scale(f * depthFactor, depthFactor)
  ctx.globalAlpha = 1.0

  const sSeed = Math.abs(worldSeed) || 1

  switch(type) {
    case 'grandstand': {
      // Tiered Spectator Stand
      ctx.fillStyle = 'rgba(45, 45, 55, 0.92)'
      ctx.fillRect(4, -38, 64, 38)
      ctx.fillStyle = sec.edge
      ctx.fillRect(4, -40, 64, 2.5)

      // Seating steps
      for (let i = 0; i < 4; i++) {
        ctx.fillStyle = `rgba(60, 65, 80, ${0.6 + i * 0.1})`
        ctx.fillRect(6 + i * 4, -34 + i * 8, 58 - i * 4, 7)
      }
      // Spectator Crowd (seeded deterministically by worldSeed)
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 7; c++) {
          const personSeed = seed(sSeed * 13 + r * 7 + c)
          const bounce = Math.sin(t * 3 + r * 0.8 + c * 1.2) * 1.2
          ctx.fillStyle = `hsl(${Math.floor(personSeed * 360)}, 65%, 55%)`
          ctx.fillRect(9 + c * 7 + r * 3, -33 + r * 8 + bounce, 3.5, 4.5)
        }

    case 'led_barrier': {
      // FIA Heavy Barrier with Sponsor Board
      ctx.fillStyle = '#282832'
      ctx.fillRect(2, -22, 54, 22)
      ctx.fillStyle = '#404050'
      ctx.fillRect(2, -22, 54, 3)

      ctx.strokeStyle = sec.edge
  ctx.closePath()
  ctx.stroke()

  // ── BLUE ENERGY CORE (centered) ──
  const coreGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, coreR)
  coreGrad.addColorStop(0, `rgba(200, 240, 255, ${0.9 * pulse})`)
  coreGrad.addColorStop(0.35, `rgba(0, 200, 255, ${0.8 * pulse})`)
  coreGrad.addColorStop(0.7, `rgba(0, 120, 220, ${0.5 * pulse})`)
  coreGrad.addColorStop(1, 'rgba(0, 80, 180, 0)')
  ctx.fillStyle = coreGrad
  ctx.beginPath()
  ctx.arc(0, 0, coreR * (1 + rushPulse * 0.3), 0, Math.PI * 2)
  ctx.fill()

  // Core bright center dot
  ctx.fillStyle = `rgba(220, 245, 255, ${0.85 * pulse})`
  ctx.beginPath()
  ctx.arc(0, 0, coreR * 0.35, 0, Math.PI * 2)
  ctx.fill()

  // ── SUBTLE LIGHTNING BOLT SYMBOL ──
  ctx.save()
  ctx.globalAlpha = 0.55 * pulse
  ctx.arcTo(-capW, capH, -capW, capH - capW, capW)
  ctx.closePath()
  ctx.fill()

  // ── CYAN ACCENT STRIPES ──
  ctx.fillStyle = '#00b8ff'
  ctx.fillRect(-capW + 1.5, -capH * 0.85, capW * 2 - 3, 2.5)
  ctx.fillRect(-capW + 1.5, capH * 0.85 - 2.5, capW * 2 - 3, 2.5)

  // Thinner middle cyan accent
  ctx.fillStyle = 'rgba(0, 200, 255, 0.5)'
  ctx.fillRect(-capW + 3, -1, capW * 2 - 6, 1.5)

  // ── METALLIC EDGE HIGHLIGHT ──
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)'
  ctx.lineWidth = 0.8
  ctx.beginPath()
  ctx.moveTo(-capW, -capH + capW)
  ctx.arcTo(-capW, -capH, 0, -capH, capW)
  ctx.arcTo(capW, -capH, capW, -capH + capW, capW)
  ctx.lineTo(capW, capH - capW)
  ctx.arcTo(capW, capH, 0, capH, capW)
  ctx.arcTo(-capW, capH, -capW, capH - capW, capW)
  ctx.closePath()
  ctx.stroke()

  // ── BLUE ENERGY CORE (centered) ──
  const coreGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, coreR)
  coreGrad.addColorStop(0, `rgba(200, 240, 255, ${0.9 * pulse})`)
  coreGrad.addColorStop(0.35, `rgba(0, 200, 255, ${0.8 * pulse})`)
  coreGrad.addColorStop(0.7, `rgba(0, 120, 220, ${0.5 * pulse})`)
  coreGrad.addColorStop(1, 'rgba(0, 80, 180, 0)')
  ctx.fillStyle = coreGrad
  ctx.beginPath()
  ctx.arc(0, 0, coreR * (1 + rushPulse * 0.3), 0, Math.PI * 2)
  ctx.fill()

  // Core bright center dot
  ctx.fillStyle = `rgba(220, 245, 255, ${0.85 * pulse})`
  ctx.beginPath()
  ctx.arc(0, 0, coreR * 0.35, 0, Math.PI * 2)
  ctx.fill()

  // ── SUBTLE LIGHTNING BOLT SYMBOL ──
  ctx.save()
  ctx.globalAlpha = 0.55 * pulse
  ctx.fillStyle = '#ffffff'
  ctx.globalAlpha = 0.25
  const specGrad = ctx.createLinearGradient(0, -capH, 0, -capH * 0.2)
  specGrad.addColorStop(0, '#ffffff')
  specGrad.addColorStop(1, 'rgba(255,255,255,0)')
  ctx.fillStyle = specGrad
  ctx.beginPath()
  ctx.moveTo(-capW + 3, -capH + capW)
  ctx.arcTo(-capW + 3, -capH + 2, 0, -capH + 2, capW - 2)
  ctx.arcTo(capW - 3, -capH + 2, capW - 3, -capH + capW, capW - 2)
  ctx.lineTo(capW - 3, -capH * 0.2)
  ctx.lineTo(-capW + 3, -capH * 0.2)
  ctx.closePath()
  ctx.fill()
  ctx.restore()

  ctx.restore() // end rotation

  ctx.restore() // end translate
}

