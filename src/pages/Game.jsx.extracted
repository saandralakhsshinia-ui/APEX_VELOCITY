class ScorePopup {
  constructor(x, y, text, bonusText, color, comboLevel = 1) {
    this.x = x
    this.y = y
    this.text = text
    this.bonusText = bonusText
    this.color = color
    this.comboLevel = comboLevel
    this.life = 1.0
    this.decay = 0.016
    this.scale = 0.3
    this.targetScale = 1.0 + Math.min(0.45, (comboLevel - 1) * 0.15)
  }
  update() {
    this.y -= 1.8
    this.life -= this.decay
    this.scale += (this.targetScale - this.scale) * 0.24
  }
  draw(ctx) {
    if (this.life <= 0) return
    ctx.save()
    ctx.globalAlpha = Math.max(0, this.life)
    ctx.translate(this.x, this.y)
    ctx.scale(this.scale, this.scale)

    const fontSize = 14 + Math.min(7, this.comboLevel * 2)
    ctx.shadowColor = this.color
    ctx.shadowBlur = 18
    ctx.font = `bold ${fontSize}px Orbitron, sans-serif`
    ctx.textAlign = 'center'
    ctx.fillStyle = this.color
    ctx.fillText(this.text, 0, 0)

    if (this.bonusText) {
      ctx.font = `bold ${fontSize + 4}px JetBrains Mono, monospace`
      ctx.fillStyle = '#ffffff'
      ctx.fillText(this.bonusText, 0, fontSize + 5)
    }

    ctx.shadowBlur = 0
    ctx.restore()
  }
}

