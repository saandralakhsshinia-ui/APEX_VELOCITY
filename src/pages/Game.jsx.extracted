                    border: '1.5px solid rgba(255, 255, 255, 0.25)',
                    borderRadius: '8px',
                    padding: '0.8rem 1rem',
                    color: '#ffffff',
                    fontFamily: 'Orbitron, sans-serif',
                    fontSize: '0.75rem',
                    fontWeight: 900,
                    fontStyle: 'italic',
                    letterSpacing: '0.15em',
                    cursor: 'pointer',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    gap: '0.5rem',
                    transform: 'skewX(-10deg)',
                    boxShadow: '0 4px 15px rgba(0,0,0,0.5)'
