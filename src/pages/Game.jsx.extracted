function drawPlayer(ctx, x, y, skin, st) {
  const w=PW, h=PH, hw=w/2, hh=h/2
  const cx=x+hw, cy=y+hh
  const spdR = Math.min(1, (st.speed||4)/20)
  const isSpeedZone = st.activeEvent === 'speed_zone'
  const isNitro = st.nitroActive

  const vx = (Math.random()-0.5)*1.2*spdR
  const vy = (Math.random()-0.5)*0.7*spdR
  const steer = st.steerAngle * 0.04

  ctx.save()
  ctx.translate(cx+vx, cy+vy)
  ctx.rotate(steer)

}

